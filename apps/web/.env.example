# Copy to .env.local for local dev. On Netlify, set these under
# Project configuration → Environment variables. Never prefix secrets with NEXT_PUBLIC_.

# Public site URL (canonical links, sitemap, Stripe return URLs). Netlify sets URL automatically.
SITE_URL=http://localhost:3000

# Launch mode: public visitors see /coming-soon; the team unlocks the full site at /preview.
COMING_SOON=1
PREVIEW_PASSWORD=            # 10+ characters
SITE_NOINDEX=1               # keep search engines out while the catalog is sample data

# Admin panel at /admin. Blank = /admin returns 404.
ADMIN_PASSWORD=              # 12+ characters
ADMIN_SESSION_SECRET=        # optional: `openssl rand -base64 32`; rotating it signs everyone out

# Stripe (checkout + order recording). Blank = checkout says payments are off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # webhook endpoint: /api/stripe/webhook, event checkout.session.completed

# Email (quote confirmations). Blank = emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=

# Local dev only: where data is stored when not on Netlify (Netlify uses Blobs automatically).
# FF_DATA_DIR=.data
