# Copy to .env.local. Never prefix secrets with NEXT_PUBLIC_.

# Public site URL (canonical links, sitemap, Stripe return URLs)
SITE_URL=http://localhost:3000

# Stripe (checkout). Leave blank to run without payments; checkout will say so.
STRIPE_SECRET_KEY=

# Admin screens (/admin). Leave blank and /admin returns 404.
ADMIN_USER=
ADMIN_PASSWORD=
